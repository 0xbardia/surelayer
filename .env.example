# Runtime configuration is read from .env when the process starts.
# Values in this file are safe placeholders; never commit a real secret.
GENLAYER_NETWORK=studionet
GENLAYER_CHAIN_ID=61999
GENLAYER_CONTRACT_ADDRESS=
# Credential-free public RPC endpoint only.
GENLAYER_RPC_URL=https://studio.genlayer.com/api
APP_URL=http://localhost:3000
# Comma-separated on-chain protocol-test claim IDs to label as demonstrations.
PROTOCOL_TEST_CLAIM_IDS=

# Never add a private key, seed phrase, signing credential, token, or password.
